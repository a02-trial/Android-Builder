[
  {
    "kernelSource": {
      "name": "SM-A022F",
      "repo": "https://github.com/a02-trial/BR_Kernel_a02",
      "branch": "kernelku",
      "device": "a02",
      "defconfig": "a02_defconfig"
    },
    "toolchains": [
      {
        "repo": "https://github.com/LineageOS/android_prebuilts_clang_kernel_linux-x86_clang-r416183b.git",
        "branch": "lineage-20.0",
        "name": "clang",
        "binaryEnv": [
          "bin"
        ]
      },
      {
        "repo": "https://github.com/LineageOS/android_prebuilts_gcc_linux-x86_arm_arm-linux-androideabi-4.9.git",
        "branch": "lineage-19.1",
        "name": "arm",
        "binaryEnv": [
          "bin"
        ]
      }
    ],
    "enableCcache": true,
    "params": {
      "ARCH": "arm",
      "CC": "clang",
      "externalCommands": {
        "CLANG_TRIPLE": "arm-linux-gnueabi-",
        "CROSS_COMPILE": "arm-linux-androideabi-",
        "LD": "ld.lld"
      }
    },
    "AnyKernel3": {
      "use": true,
      "release": true,
      "custom": {
        "repo": "https://github.com/easterNday/AnyKernel3/",
        "branch": "thyme"
      }
    },
    "enableKernelSU": false,
    "enableLXC": false
  }
]
