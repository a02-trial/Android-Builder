[
  {
    "kernelSource": {
      "name": "SM-A022F",
      "repo": "https://github.com/a02-trial/a022f_kernel",
      "branch": "kernel11",
      "device": "a02",
      "defconfig": "a02_defconfig"
    },
    "toolchains": [
      {
        "repo": "https://android.googlesource.com/platform/prebuilts/clang/host/linux-x86",
        "branch": "android-11.0.0_r3/clang-r383902",
        "name": "clang",
        "binaryEnv": [
          "bin"
        ]
      },
      {
        "repo": "https://android.googlesource.com/platform/prebuilts/gcc/linux-x86/arm/arm-linux-androideabi-4.9",
        "branch": "android11-release",
        "name": "arm",
        "binaryEnv": [
          "bin"
        ]
      }
    ],
    "enableCcache": true,
    "params": {
      "ARCH": "arm",
      "CC": "clang",
      "externalCommands": {
        "CLANG_TRIPLE": "arm-linux-gnueabi-",
        "CROSS_COMPILE": "arm-linux-androideabi-",
        "LD": "ld.lld"
      }
     }, 
    "AnyKernel3": 
      "use": true,
      "release": true
 }
]
